{
  "tasks": {
    "check": "deno check --config supabase/functions/reminder-bot/deno.json supabase/functions/reminder-bot/index.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "db": "bash scripts/local-db.sh start",
    "cards": "deno run -A scripts/render-cards.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "pg": "npm:pg@8.23.1",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2"
  },
  "fmt": {
    "lineWidth": 130,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
